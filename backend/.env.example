# Admin login password for the dashboard
ADMIN_PASSWORD=change-me
# Random string used to sign admin sessions (run: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=change-me-too

# Public URL of the frontend, used to build invite links (no trailing slash)
PUBLIC_URL=http://localhost:5173
# Origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Google Drive (OAuth). Leave blank to keep photos on the server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Name of the folder the app creates in your Drive on first upload
GOOGLE_DRIVE_FOLDER_NAME=Wedding Photos

# Max upload size per file in MB
MAX_UPLOAD_MB=50
