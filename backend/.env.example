# Admin login password for the dashboard
ADMIN_PASSWORD=
# Random string used to sign admin sessions (run: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Public URL of the frontend, used to build invite links (no trailing slash)
PUBLIC_URL=http://localhost:5173
# Origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173


# Database. Leave blank to use a local SQLite file (backend/data/wedding.db).
# For Supabase use the "Session pooler" connection string (Project > Connect), with your password filled in:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
